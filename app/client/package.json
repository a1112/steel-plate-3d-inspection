{
  "name": "steel-plate-3d-inspection",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:service": "node scripts/dev-with-service.mjs",
    "build": "tsc && vite build",
    "service:build": "cargo build --manifest-path ../service/Cargo.toml",
    "service:start": "../../target/cargo/debug/steel-inspection-service",
    "build:standalone": "npm run capture:configure && npm run capture:build && tauri build",
    "capture:configure": "node scripts/cmake.mjs configure",
    "capture:build": "node scripts/cmake.mjs build",
    "capture:start": "../../target/capture/Release/steel_capture_service.exe --port 4317",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@tauri-apps/api": "^2.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.8.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.6.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
