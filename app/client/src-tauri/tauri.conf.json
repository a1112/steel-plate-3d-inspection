{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "北满特钢小棒检测系统",
  "version": "0.1.0",
  "identifier": "com.bkgy.steel-plate-3d-inspection",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1432",
    "beforeBuildCommand": "npm run build",
    "features": [],
    "frontendDist": "../../../target/client/frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "\u5317\u6ee1\u7279\u94a2\u5c0f\u68d2\u68c0\u6d4b\u7cfb\u7edf",
        "width": 1680,
        "height": 945,
        "minWidth": 1366,
        "minHeight": 768,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost http://*:* https://*:*; img-src 'self' asset: http://asset.localhost http://*:* https://*:* blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "publisher": "\u5317\u79d1\u5de5\u7814",
    "shortDescription": "\u94a2\u677f\u4e09\u7ef4\u68c0\u6d4b\u64cd\u4f5c\u7aef",
    "longDescription": "\u94a2\u677f\u4e09\u7ef4\u91c7\u96c6\u3001\u91cd\u5efa\u3001\u68c0\u6d4b\u4e0e\u8fd0\u884c\u72b6\u6001\u7ba1\u7406\u64cd\u4f5c\u7aef\u3002",
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  }
}
