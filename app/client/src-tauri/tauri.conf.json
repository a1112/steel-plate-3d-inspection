{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bar Surface 3D Reconstruction",
  "version": "0.1.0",
  "identifier": "com.bkgy.steel-plate-3d-inspection",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1432",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../target/client/frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "\u68d2\u6750\u8868\u9762 3D \u91cd\u5efa\u5de5\u4f5c\u53f0",
        "width": 1680,
        "height": 945,
        "minWidth": 1366,
        "minHeight": 768,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
