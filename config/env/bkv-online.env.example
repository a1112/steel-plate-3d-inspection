# DEPRECATED / ISOLATED: BKV online is retained only for controlled migration
# and compatibility verification. Do not use it as the normal runtime site.
# Raw-source credentials are consumed only by the standalone BKV adapter;
# steel-inspection-service runs in proxy-only mode and never opens BKV MySQL or
# shared image directories. Copy this file to an ignored *.local file before use.
STEEL_ENABLE_DEPRECATED_BKV_ONLINE=1
STEEL_SITE_CONFIG_ID=bkv-default
INSPECTION_SERVICE_PORT=4873
STEEL_IMAGE_SERVICE_PORT=4874
STEEL_ALGORITHM_SERVICE_PORT=4875
STEEL_RESULT_PROXY_ONLY=1
STEEL_CAPTURE_MANAGED_BY_SUPERVISOR=1
STEEL_RESULT_ROOT=state-root\result-data
STEEL_ALGORITHM_INPUT_ROOTS=state-root\algorithm-input
STEEL_TRIGGER_HEALTH_REQUIRED=1
STEEL_PROJECT_CONFIG_PATH=config/project.json
STEEL_RUNTIME_PROFILE=production
STEEL_ALGORITHM_MODE=production
BAR_SURFACE_MOCK_DEFECT_COUNT=0
STEEL_DATABASE_ENGINE=sqlite

STEEL_BKV_MYSQL_HOST=10.5.241.17
STEEL_BKV_MYSQL_PORT=3306
STEEL_BKV_MYSQL_DATABASE=ncdtube
STEEL_BKV_CONNECT_TIMEOUT_MS=5000
STEEL_BKV_RECORD_LIMIT=500
STEEL_BKV_DEFECT_WINDOW=5000
STEEL_BKV_REFRESH_INTERVAL_MS=5000

# Set credentials only in an ignored *.local env file or an approved secret store.
STEEL_BKV_MYSQL_USER=
STEEL_BKV_MYSQL_PASSWORD=

# Image roots default to \\STEEL_BKV_MYSQL_HOST\CamImageSource1 through
# \\STEEL_BKV_MYSQL_HOST\CamImageSource6. Override individual roots only when
# the image server differs from the database host.
STEEL_BKV_IMAGE_ROOT_1=
STEEL_BKV_IMAGE_ROOT_2=
STEEL_BKV_IMAGE_ROOT_3=
STEEL_BKV_IMAGE_ROOT_4=
STEEL_BKV_IMAGE_ROOT_5=
STEEL_BKV_IMAGE_ROOT_6=
