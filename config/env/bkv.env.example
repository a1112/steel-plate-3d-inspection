# Formal BKV offline replay: no camera SDK process and no physical camera operations.
INSPECTION_SERVICE_PORT=4873
STEEL_CAPTURE_PROVIDER=bkv

# Replace this example with the canonical absolute directory containing
# bkv-runtime-manifest.json, image_copy2, bkv-standard-v1, and stitch-preview.
STEEL_BKV_DATA_ROOT=D:\Project\steel-plate-3d-inspection\tmp\legacy-bkv
# Both overrides are optional and must remain beneath STEEL_BKV_DATA_ROOT.
STEEL_BKV_MANIFEST_PATH=D:\Project\steel-plate-3d-inspection\tmp\legacy-bkv\bkv-runtime-manifest.json
STEEL_BKV_CURSOR_PATH=D:\Project\steel-plate-3d-inspection\tmp\legacy-bkv\runtime-state\replay.json

STEEL_RUNTIME_PROFILE=development
STEEL_ALGORITHM_MODE=production
BAR_SURFACE_MOCK_DEFECT_COUNT=0
STEEL_CAPTURE_SERVICE_AUTOSTART=0
STEEL_TRIGGER_HEALTH_REQUIRED=0
