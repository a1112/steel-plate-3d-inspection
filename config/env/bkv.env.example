# Formal BKV offline replay: no camera SDK process and no physical camera operations.
INSPECTION_SERVICE_PORT=4873
STEEL_CAPTURE_PROVIDER=bkv
STEEL_PROJECT_CONFIG_PATH=D:\Project\steel-plate-3d-inspection\config\project.json

# BKV runtime state remains local SQLite. The converted business catalog is the
# separate storage.catalogPath selected by config/project.json -> bkv-6.json.
STEEL_DATABASE_ENGINE=sqlite
STEEL_DATABASE_FALLBACK=none

# The legacy root is read-only converter input and compatibility metadata only.
# Runtime records/defects/tiles are read from storage.convertedRoot after:
# python scripts/bkv_import_service.py --project config/project.json --once
STEEL_BKV_DATA_ROOT=D:\Project\steel-plate-3d-inspection\tmp\legacy-bkv
# Both compatibility overrides must remain beneath STEEL_BKV_DATA_ROOT.
STEEL_BKV_MANIFEST_PATH=D:\Project\steel-plate-3d-inspection\tmp\legacy-bkv\bkv-runtime-manifest.json
STEEL_BKV_CURSOR_PATH=D:\Project\steel-plate-3d-inspection\tmp\legacy-bkv\runtime-state\replay.json

STEEL_RUNTIME_PROFILE=development
STEEL_ALGORITHM_MODE=production
BAR_SURFACE_MOCK_DEFECT_COUNT=0
STEEL_CAPTURE_SERVICE_AUTOSTART=0
STEEL_TRIGGER_HEALTH_REQUIRED=0
