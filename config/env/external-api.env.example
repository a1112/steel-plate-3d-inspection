# Rust service connects to an already started capture API process.
INSPECTION_SERVICE_PORT=4873
STEEL_CAPTURE_PROVIDER=external-api
STEEL_RUNTIME_PROFILE=production
STEEL_ALGORITHM_MODE=production
BAR_SURFACE_MOCK_DEFECT_COUNT=0
# Production readiness also requires STEEL_ALGORITHM_ACCEPTANCE_REPORT,
# STEEL_ALGORITHM_CALIBRATION_PATH, STEEL_BAR_SURFACE_CORE_EXE, and the exact
# 40-64 hexadecimal STEEL_RELEASE_COMMIT. Use install-runtime-service.ps1 to
# bind and validate these values instead of copying placeholders.
# Empty production databases require STEEL_BOOTSTRAP_ADMIN_PASSWORD from a secret store.
# Never commit that password to an env file.
CAPTURE_SERVICE_ORIGIN=http://127.0.0.1:4317
STEEL_CAPTURE_SERVICE_AUTOSTART=0
TRIGGER_GATEWAY_ORIGIN=http://127.0.0.1:4881
STEEL_TRIGGER_HEALTH_REQUIRED=1
# Readiness fails closed when the least-free configured capture root crosses either watermark.
STEEL_STORAGE_MIN_FREE_BYTES=21474836480
STEEL_STORAGE_MIN_FREE_PERCENT=10
# Required before record deletion/retention. Enumerate only production capture, summary, and reconstruction directories.
# Windows path-list separator is semicolon; do not use the drive root or include config/calibration/profile directories.
# STEEL_ARTIFACT_ALLOWED_ROOTS=H:\camera1;H:\camera2;H:\camera3;H:\camera4;H:\camera5;H:\camera6;H:\camera7;H:\camera8;H:\production;H:\reconstruction
