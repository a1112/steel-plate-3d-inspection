# Non-secret environment for the SteelInspectionRuntime Windows service.
# install-runtime-service.ps1 writes target/runtime/config/env/runtime-service.env from reviewed site parameters.
STEEL_RUNTIME_PROFILE=production
STEEL_ALGORITHM_MODE=production
BAR_SURFACE_MOCK_DEFECT_COUNT=0
# The installer writes exact absolute package/site paths and the clean package commit here.
# STEEL_ALGORITHM_ACCEPTANCE_REPORT=D:\steel-runtime\site-evidence\algorithm-acceptance.json
# STEEL_ALGORITHM_CALIBRATION_PATH=D:\steel-runtime\config\capture\calibrations\current-8-time-trigger\ArrayCalibration.xml
# STEEL_BAR_SURFACE_CORE_EXE=D:\steel-runtime\algorithm-core\steel_bar_surface_core.exe
# STEEL_RELEASE_COMMIT=0123456789abcdef0123456789abcdef01234567
INSPECTION_SERVICE_HOST=0.0.0.0
# Optional explicit address advertised by automatic discovery on multi-NIC hosts.
# INSPECTION_SERVICE_ADVERTISED_HOST=192.168.1.20
INSPECTION_SERVICE_PORT=4873
STEEL_CAPTURE_PROVIDER=external-api
CAPTURE_SERVICE_ORIGIN=http://127.0.0.1:4317
STEEL_CAPTURE_SERVICE_AUTOSTART=0
CAPTURE_STORAGE_ROOT=H:\
CAPTURE_CAMERA_STORAGE_ROOT=H:\
STEEL_BAR_CAPTURE_ROOT=H:\
STEEL_ALGORITHM_DATA_ROOT=H:\reconstruction
# Hard upper bound for Python reconstruction, calibration fitting, and C++ core computation.
# Queued algorithm tasks may be cooperatively cancelled before device activation; timeout/cancel kills only the calculation child.
STEEL_ALGORITHM_PROCESS_TIMEOUT_SEC=1800
# The installer derives this beneath the mutable StateRoot.
STEEL_REPORT_ARCHIVE_ROOT=C:\ProgramData\SteelInspectionRuntime\reports\inspection
TRIGGER_GATEWAY_HOST=127.0.0.1
TRIGGER_GATEWAY_PORT=4881
TRIGGER_GATEWAY_ORIGIN=http://127.0.0.1:4881
TRIGGER_SOURCE_ALLOWLIST=127.0.0.1/32
TRIGGER_ALLOW_MODE_MUTATION=0
STEEL_TRIGGER_HEALTH_REQUIRED=1
STEEL_STORAGE_MIN_FREE_BYTES=21474836480
STEEL_STORAGE_MIN_FREE_PERCENT=10
# Required site-specific example; enumerate narrow production roots only.
STEEL_ARTIFACT_ALLOWED_ROOTS=H:\camera1;H:\camera2;H:\camera3;H:\camera4;H:\camera5;H:\camera6;H:\camera7;H:\camera8;H:\production;H:\reconstruction
