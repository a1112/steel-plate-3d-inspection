# SICK GenTL producer installed with the SICK camera software.
SICK_GENTL_CTI=C:\Program Files\SICK\GenTL\SICKGigEVisionTL.cti

# The Rust service talks to the externally started Python SICK sidecar.
STEEL_CAPTURE_PROVIDER=external-api
STEEL_CAPTURE_SERVICE_AUTOSTART=0
CAPTURE_SERVICE_ORIGIN=http://127.0.0.1:4317
STEEL_SITE_CONFIG_ID=sick-single-lab
