# Development-only stack: MySQL is primary and local SQLite is an explicit fallback.
INSPECTION_SERVICE_PORT=4873
STEEL_CAPTURE_PROVIDER=simulated
STEEL_RUNTIME_PROFILE=development
STEEL_ALGORITHM_MODE=demo
BAR_SURFACE_MOCK_DEFECT_COUNT=0
STEEL_CAPTURE_SERVICE_AUTOSTART=0
STEEL_TRIGGER_HEALTH_REQUIRED=0
STEEL_DATABASE_ENGINE=mysql
STEEL_DATABASE_FALLBACK=sqlite
STEEL_DATABASE_CONNECT_TIMEOUT_MS=3000
STEEL_MYSQL_HOST=127.0.0.1
STEEL_MYSQL_PORT=3306
STEEL_MYSQL_DATABASE=steel_inspection
# Development defaults are root / nercar when these are omitted.
# Override locally; never reuse those defaults in production.
