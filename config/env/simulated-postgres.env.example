# Development-only stack: PostgreSQL is primary and local SQLite is an explicit fallback.
INSPECTION_SERVICE_PORT=4873
STEEL_CAPTURE_PROVIDER=simulated
STEEL_RUNTIME_PROFILE=development
STEEL_ALGORITHM_MODE=demo
BAR_SURFACE_MOCK_DEFECT_COUNT=0
STEEL_CAPTURE_SERVICE_AUTOSTART=0
STEEL_TRIGGER_HEALTH_REQUIRED=0
STEEL_DATABASE_ENGINE=postgres
STEEL_DATABASE_FALLBACK=sqlite
STEEL_DATABASE_CONNECT_TIMEOUT_MS=3000
STEEL_POSTGRES_HOST=127.0.0.1
STEEL_POSTGRES_PORT=5432
STEEL_POSTGRES_DATABASE=steel_inspection
STEEL_POSTGRES_SSL_MODE=disable
# Development defaults are postgres / postgres when these are omitted.
# Override locally; PostgreSQL is intentionally rejected by production profiles.
