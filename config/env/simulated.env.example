# Rust service uses the built-in eight-camera simulation fallback.
INSPECTION_SERVICE_PORT=4873
STEEL_CAPTURE_PROVIDER=simulated
STEEL_RUNTIME_PROFILE=development
STEEL_ALGORITHM_MODE=demo
BAR_SURFACE_MOCK_DEFECT_COUNT=0
STEEL_CAPTURE_SERVICE_AUTOSTART=0
TRIGGER_GATEWAY_ORIGIN=http://127.0.0.1:4881
# Development-only service runs may explicitly make trigger readiness optional.
STEEL_TRIGGER_HEALTH_REQUIRED=0
