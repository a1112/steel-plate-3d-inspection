# Standalone trigger gateway for L2/PLC/API steel events.
TRIGGER_GATEWAY_PORT=4881
TRIGGER_GATEWAY_HOST=127.0.0.1
INSPECTION_SERVICE_ORIGIN=http://127.0.0.1:4873
# api = external API controls in/out steel; gray = grayscale/sensor-side trigger tag;
# secondary = L2/二级 trigger tag; manual enables the local manual steel-in/out page.
TRIGGER_MODE=api
