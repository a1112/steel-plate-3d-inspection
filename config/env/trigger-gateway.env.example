# Standalone trigger gateway for L2/PLC/API steel events.
STEEL_RUNTIME_PROFILE=development
TRIGGER_GATEWAY_PORT=4881
TRIGGER_GATEWAY_HOST=127.0.0.1
# Newline-delimited JSON over TCP. Set to 0 to disable.
TRIGGER_TCP_PORT=4882
# One JSON object per UDP datagram. Set to 0 to disable.
TRIGGER_UDP_PORT=4883
INSPECTION_SERVICE_ORIGIN=http://127.0.0.1:4873
# api/http, tcp and udp identify the external trigger transport; gray and secondary
# retain compatibility source tags; manual enables the local operator controls.
TRIGGER_MODE=api
# Development loopback keeps authentication optional. Production always requires a
# secret of at least 32 bytes, even if TRIGGER_AUTH_REQUIRED is set to 0.
TRIGGER_AUTH_REQUIRED=0
TRIGGER_AUTH_WINDOW_SECONDS=30
TRIGGER_ALLOW_MODE_MUTATION=1
# Production non-loopback example (inject the secret through the service manager;
# never commit it to this file):
# STEEL_RUNTIME_PROFILE=production
# TRIGGER_GATEWAY_HOST=10.20.30.40
# TRIGGER_SHARED_SECRET=<inject-at-least-32-random-bytes>
# TRIGGER_OPERATOR_TOKEN=<inject-a-different-at-least-32-byte-random-token>
# TRIGGER_SOURCE_ALLOWLIST=10.20.30.10,10.20.31.0/24
# TRIGGER_ALLOW_MODE_MUTATION=0
