{
  "schema": "steel.source-processing-config.v1",
  "processor": "bkv-inspection-world-v1",
  "processorVersion": "1.0.0",
  "input": {
    "intensityDirectory": "2D",
    "sourceAdapters": ["bkv-mysql", "capture-manifest", "standard-record-v2"],
    "resultSchema": "steel.inspection-result.v1",
    "resultRoot": "target/data/inspection-results",
    "intensityExtension": "bmp",
    "depthDirectory": "3D",
    "depthExtension": "d3img",
    "cameraCount": 6
  },
  "inspectionWorld": {
    "tileSize": 128,
    "tileFormats": [
      "jpeg",
      "png"
    ],
    "detectHeadAlignment": true,
    "cacheTiles": true
  },
  "persistence": {
    "rawCopy": false,
    "writeManifest": true,
    "writeTiming": true,
    "appendTimingLog": true,
    "databaseSnapshot": {
      "enabled": true,
      "format": "json",
      "catalogFile": "latest-500.json",
      "perRunFile": "source-record.json",
      "rawSql": false
    }
  }
}
