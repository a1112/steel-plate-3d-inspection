{
  "schema": "steel.source-processing-config.v1",
  "processor": "sick-flow-event-v2",
  "processorVersion": "2.0.0",
  "input": {
    "cameraCount": 6,
    "depthFormat": "Coord3D_C16",
    "intensityFormat": "Mono8",
    "depthUnit": "calibrated-mm"
  },
  "inspectionWorld": {
    "tileSize": 128,
    "detectHeadAlignment": true,
    "cacheTiles": true
  },
  "depthGeometry": {
    "schema": "steel.sick-depth-geometry-config.v1",
    "enabled": true,
    "revision": 6,
    "candidatePolicy": "review-only",
    "longitudinalEdgeGuardFrames": 8,
    "cameraWorkers": 4,
    "maximumCandidatesPerFlow": 100,
    "baseline": {
      "maximumFrames": 32,
      "rowSampleStep": 4
    },
    "thresholds": {
      "minimumAbsoluteDeviationMm": 1.2,
      "columnNoiseMultiplier": 6.0,
      "minimumNeighborhoodSupport": 3,
      "minimumComponentPoints": 16,
      "elongatedAspectRatio": 3.0
    },
    "merge": {
      "maximumFrameGap": 1,
      "minimumIoU": 0.2
    },
    "reviewCropMinimumSize": 64,
    "qualityGatePolicy": "global-owned-only",
    "longitudinalScale": null,
    "historyBackfill": {
      "automatic": true,
      "order": "newest-first",
      "livePriority": true,
      "pauseHistoricalIoWhileCaptureActive": true,
      "gpuDeviceId": 1
    }
  }
}
