{
  "schema": "steel.capture.profile.v1",
  "name": "sick-single-lab",
  "driverMode": "sick-gentl",
  "storageRoot": "D:\\steel-sick-data",
  "autoConnect": true,
  "expectedCameras": 1,
  "sick": {
    "ctiPath": "%SICK_GENTL_CTI%",
    "ctiSha256": "<FAT_APPROVED_CTI_SHA256>",
    "deviceScanType": "Linescan3D",
    "expectedDepthFormats": [
      "Coord3D_C16"
    ],
    "expectedIntensityFormats": [
      "Mono8"
    ]
  },
  "captureDefaults": {
    "timeoutMs": 8000,
    "blackFrameThreshold": 1.0,
    "grayscaleSteelDetection": true,
    "steelBrightPixelThreshold": 8.0,
    "steelBrightPixelRatio": 0.02,
    "steelEntryRounds": 2,
    "steelExitRounds": 8,
    "steelPreRollFrames": 1,
    "steelPostRollFrames": 1,
    "blackFrameCacheRounds": 8,
    "storageWriteCacheRounds": 128
  },
  "compatibility": {
    "lg3d": true,
    "jpegQuality": 95,
    "fsync": false,
    "metadataCommitLast": true
  },
  "cameras": [
    {
      "cameraIndex": 1,
      "id": "C1",
      "key": "C1",
      "serialNumber": "<REQUIRED_SICK_SERIAL_NUMBER>",
      "model": "<REQUIRED_SICK_MODEL>",
      "firmware": "<REQUIRED_SICK_FIRMWARE>",
      "ip": "<REQUIRED_SICK_IP>",
      "role": "sick-array-1",
      "storageRoot": "D:\\steel-sick-data\\C1",
      "enabled": true,
      "nodeOverrides": {}
    }
  ]
}
