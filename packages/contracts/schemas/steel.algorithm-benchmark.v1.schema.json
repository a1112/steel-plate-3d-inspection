{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steel.algorithm-benchmark.v1",
  "title": "Comparable steel inspection algorithm benchmark evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmarkId",
    "createdAt",
    "identity",
    "environment",
    "workload",
    "protocol",
    "stages",
    "resources",
    "result",
    "artifacts"
  ],
  "properties": {
    "schema": { "const": "steel.algorithm-benchmark.v1" },
    "benchmarkId": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "reproductionManifest",
        "dataset",
        "modelSet",
        "algorithmConfig",
        "calibration",
        "evaluator"
      ],
      "properties": {
        "release": { "$ref": "#/$defs/versionedAsset" },
        "reproductionManifest": { "$ref": "#/$defs/versionedAsset" },
        "dataset": { "$ref": "#/$defs/versionedAsset" },
        "modelSet": { "$ref": "#/$defs/versionedAsset" },
        "algorithmConfig": { "$ref": "#/$defs/versionedAsset" },
        "calibration": { "$ref": "#/$defs/versionedAsset" },
        "evaluator": { "$ref": "#/$defs/versionedAsset" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "ramBytes", "gpu", "driver", "cuda", "onnxRuntime", "sickSdk", "firmware"],
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "ramBytes": { "type": "integer", "minimum": 1 },
        "gpu": { "type": "string", "minLength": 1 },
        "driver": { "type": "string", "minLength": 1 },
        "cuda": { "type": "string", "minLength": 1 },
        "onnxRuntime": { "type": "string", "minLength": 1 },
        "sickSdk": { "type": "string", "minLength": 1 },
        "firmware": { "type": "string", "minLength": 1 }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cameraCount", "frameCount", "width", "height", "validPointCount", "batchSize", "dataLocation"],
      "properties": {
        "cameraCount": { "type": "integer", "minimum": 1 },
        "frameCount": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "validPointCount": { "type": "integer", "minimum": 0 },
        "batchSize": { "type": "integer", "minimum": 1 },
        "dataLocation": { "enum": ["memory", "local-ssd", "local-hdd", "network"] }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmupRuns", "measuredRuns", "concurrency", "timer", "timingBoundary", "includesCaptureWait"],
      "properties": {
        "warmupRuns": { "type": "integer", "minimum": 0 },
        "measuredRuns": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "timer": { "type": "string", "minLength": 1 },
        "timingBoundary": { "type": "string", "minLength": 1 },
        "includesCaptureWait": { "type": "boolean" }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/stage" }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["throughputPerSecond", "peakRamBytes", "peakVramBytes", "ioBytes", "peakQueueDepth"],
      "properties": {
        "throughputPerSecond": { "type": "number", "minimum": 0 },
        "peakRamBytes": { "type": "integer", "minimum": 0 },
        "peakVramBytes": { "type": "integer", "minimum": 0 },
        "ioBytes": { "type": "integer", "minimum": 0 },
        "peakQueueDepth": { "type": "integer", "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "criteria", "checks", "comparability"],
      "properties": {
        "status": { "enum": ["pass", "fail", "blocked"] },
        "criteria": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number" }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "actual", "passed"],
            "properties": {
              "criterion": { "type": "string", "minLength": 1 },
              "actual": { "type": "number" },
              "passed": { "type": "boolean" }
            }
          }
        },
        "comparability": { "enum": ["comparable", "not-comparable"] },
        "notComparableReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timings", "command", "log"],
      "properties": {
        "timings": { "$ref": "#/$defs/asset" },
        "command": { "$ref": "#/$defs/asset" },
        "log": { "$ref": "#/$defs/asset" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "versionedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "uri", "sha256"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "uri": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count", "medianMs", "p95Ms", "maxMs", "failureCount"],
      "properties": {
        "name": {
          "enum": [
            "capture-wait",
            "source-decode",
            "preprocess",
            "gpu-detection",
            "classification",
            "postprocess",
            "publish",
            "end-to-end"
          ]
        },
        "count": { "type": "integer", "minimum": 0 },
        "medianMs": { "type": "number", "minimum": 0 },
        "p95Ms": { "type": "number", "minimum": 0 },
        "maxMs": { "type": "number", "minimum": 0 },
        "failureCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
