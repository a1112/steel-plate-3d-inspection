{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steel.algorithm-dataset-validation.v1",
  "title": "Fail-closed algorithm dataset validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool",
    "createdAt",
    "status",
    "code",
    "purpose",
    "manifest",
    "summary",
    "checks"
  ],
  "properties": {
    "schema": { "const": "steel.algorithm-dataset-validation.v1" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "validate_algorithm_dataset" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "code": { "enum": [0, 1] },
    "purpose": { "enum": ["development", "validation", "qualification", "benchmark"] },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "datasetRevision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256OrEmpty" },
        "datasetRevision": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkCount",
        "passedCount",
        "errorCount",
        "sampleCount",
        "materialCount",
        "batchCount",
        "splitCounts",
        "classCounts"
      ],
      "properties": {
        "checkCount": { "type": "integer", "minimum": 0 },
        "passedCount": { "type": "integer", "minimum": 0 },
        "errorCount": { "type": "integer", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "materialCount": { "type": "integer", "minimum": 0 },
        "batchCount": { "type": "integer", "minimum": 0 },
        "splitCounts": { "$ref": "#/$defs/countMap" },
        "classCounts": { "$ref": "#/$defs/countMap" }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status", "subject", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "status": { "enum": ["passed", "failed"] },
          "subject": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha256OrEmpty": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{64})?$"
    },
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
