{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steel.defect-report.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "inspectionId", "imageResultSha256", "defects", "complete"],
  "properties": {
    "schema": { "const": "steel.defect-report.v1" },
    "inspectionId": { "type": "string", "minLength": 1 },
    "imageResultSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "defects": { "type": "array", "items": { "type": "object" } },
    "complete": { "type": "boolean" }
  }
}
