{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steel.reproduction-manifest.v1",
  "title": "Steel inspection reproducibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifestId",
    "generator",
    "createdAt",
    "producer",
    "release",
    "environment",
    "assets",
    "commands",
    "expectedOutputs",
    "requirements"
  ],
  "properties": {
    "schema": { "const": "steel.reproduction-manifest.v1" },
    "manifestId": { "$ref": "#/$defs/id" },
    "generator": { "$ref": "#/$defs/tool" },
    "createdAt": { "type": "string", "format": "date-time" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "packageManifest"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "tag": { "type": ["string", "null"], "minLength": 1 },
        "packageManifest": { "$ref": "#/$defs/asset" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows",
        "msvc",
        "windowsSdk",
        "cmake",
        "rust",
        "node",
        "python",
        "gpu",
        "onnxRuntime",
        "sick",
        "desktopRuntime",
        "externalInstallers"
      ],
      "properties": {
        "windows": { "$ref": "#/$defs/component" },
        "msvc": { "$ref": "#/$defs/component" },
        "windowsSdk": { "$ref": "#/$defs/component" },
        "cmake": { "$ref": "#/$defs/component" },
        "rust": { "$ref": "#/$defs/component" },
        "node": { "$ref": "#/$defs/component" },
        "python": { "$ref": "#/$defs/component" },
        "gpu": { "$ref": "#/$defs/component" },
        "onnxRuntime": { "$ref": "#/$defs/component" },
        "sick": { "$ref": "#/$defs/component" },
        "desktopRuntime": { "$ref": "#/$defs/component" },
        "externalInstallers": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "annotation",
        "modelSet",
        "algorithmConfig",
        "calibration",
        "evaluator"
      ],
      "properties": {
        "dataset": { "$ref": "#/$defs/versionedAsset" },
        "annotation": { "$ref": "#/$defs/versionedAsset" },
        "modelSet": { "$ref": "#/$defs/versionedAsset" },
        "algorithmConfig": { "$ref": "#/$defs/versionedAsset" },
        "calibration": { "$ref": "#/$defs/versionedAsset" },
        "evaluator": { "$ref": "#/$defs/versionedAsset" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "smoke", "evaluate", "benchmark"],
      "properties": {
        "setup": { "$ref": "#/$defs/command" },
        "smoke": { "$ref": "#/$defs/command" },
        "evaluate": { "$ref": "#/$defs/command" },
        "benchmark": { "$ref": "#/$defs/command" }
      }
    },
    "expectedOutputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "schema"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "schema": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "absoluteTolerance": { "type": "number", "minimum": 0 },
          "relativeTolerance": { "type": "number", "minimum": 0 }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privateAssets", "gpu", "realCameras", "humanApproval"],
      "properties": {
        "privateAssets": { "type": "boolean" },
        "gpu": { "type": "boolean" },
        "realCameras": { "type": "boolean" },
        "humanApproval": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "versionedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "uri", "sha256"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "uri": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/asset" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "workingDirectory", "allowedEnvironment"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "workingDirectory": { "$ref": "#/$defs/relativePath" },
        "allowedEnvironment": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    }
  }
}
