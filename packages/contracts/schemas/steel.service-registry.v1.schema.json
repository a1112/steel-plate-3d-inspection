{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steel-inspection.local/contracts/steel.service-registry.v1.schema.json",
  "title": "Steel service registry",
  "type": "object",
  "required": ["schema", "version", "services"],
  "properties": {
    "schema": { "const": "steel.service-registry.v1" },
    "version": { "const": 1 },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "defaultOrigin", "healthPath", "required", "lifecycle"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 160 },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "role": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": { "type": "string", "maxLength": 160 },
          "defaultOrigin": { "type": "string", "pattern": "^http://[^/]+:[1-9][0-9]*$" },
          "originEnv": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "portEnv": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "healthPath": { "type": "string", "pattern": "^/[^?#[:space:]]*$", "maxLength": 160 },
          "required": { "type": "boolean" },
          "requiredWhen": { "type": "string", "enum": ["always", "bkv", "bkv-only", "non-bkv", "non-bkv-only"] },
          "lifecycle": { "type": "string", "minLength": 1, "maxLength": 160 },
          "logFiles": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "pattern": "^[^\\/:]+$", "maxLength": 160 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
